# Server
PORT=3000
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OpenAI
OPENAI_API_KEY=sk-...

# Arc Testnet (ethers.js path)
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_BASE_URL=https://testnet.arcscan.app
ARC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000

# Circle Developer-Controlled Wallets (preferred payment path)
CIRCLE_API_KEY=TEST_API_KEY:...
CIRCLE_ENTITY_SECRET=your_entity_secret_hex
CIRCLE_WALLET_SET_ID=your_wallet_set_id
CIRCLE_ARC_USDC_TOKEN_ID=your_usdc_token_id_on_arc_testnet

# Payment execution mode
# "circle" = use Circle Developer-Controlled Wallets (preferred)
# "ethers" = use ethers.js with server wallet (hackathon fallback, NOT for production)
PAYMENT_EXECUTION_MODE=circle

# Only used if PAYMENT_EXECUTION_MODE=ethers
# NEVER commit a real private key. Use testnet-only keys.
SERVER_WALLET_PRIVATE_KEY=0x...
